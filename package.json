{
  "name": "mega-dash",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "smoke": "node tools/smoke.mjs",
    "sim": "node tools/sim.mjs",
    "apk": "npm run build && npx cap sync android && node -e \"require('child_process').execFileSync(process.platform==='win32'?'gradlew.bat':'./gradlew',['assembleRelease'],{cwd:'android',stdio:'inherit'})\"",
    "status": "node tools/status.js",
    "sync": "node tools/sync-tracker.js",
    "sprites": "node tools/sprite-templates.mjs",
    "sprites:build": "node tools/sprites-build.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "vite": "^5.4.8"
  }
}
